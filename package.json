{
  "name": "crystal-overdrive",
  "version": "0.1.0",
  "private": true,
  "description": "結晶オーバードライブ Web / iOS テスト用",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "dev": "node scripts/serve-web.cjs",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios",
    "ios:prepare": "cap sync ios && node scripts/ensure-ios-orientations.cjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
